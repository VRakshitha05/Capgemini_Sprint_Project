<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Negative Testing">
<listeners>
	<listener class-name="ecommerce.SwagLabs.genericutility.ScreenshotListener"></listener>
</listeners>

    <parameter name="browser" value="chrome"/>

    <test name="Negative Login Tests">

        <classes>
            <class name="ecommerce.SwagLabs.Login.UserLoginWithInvalidUsername_Test"/>
            <class name="ecommerce.SwagLabs.Login.UserLoginWithInvalidPassword_Test"/>
            <class name="ecommerce.SwagLabs.Login.UserLoginWithInvalidCredentials_Test"/>
            <class name="ecommerce.SwagLabs.Login.UserLoginWithBlankUsername_Test"/>
            <class name="ecommerce.SwagLabs.Login.UserLoginWithBlankPassword_Test"/>
            <class name="ecommerce.SwagLabs.Login.UserLoginWithLockedUser_Test"/>
        </classes>

    </test>

</suite>
