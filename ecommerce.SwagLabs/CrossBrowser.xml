<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Cross Browser Testing"
       parallel="tests"
       thread-count="3">

    <listeners>
        <listener class-name="ecommerce.SwagLabs.genericutility.ScreenshotListener"/>
    </listeners>

    <!-- Chrome -->
    <test name="Chrome Tests">
        <parameter name="browser" value="chrome"/>

        <classes>
            <class name="ecommerce.SwagLabs.Login.UserLoginWithInvalidUsername_Test"/>
            <class name="ecommerce.SwagLabs.Cart.ProductAddedToCart_Test"/>
            <class name="ecommerce.SwagLabs.Login.UserLoginWithValidCredentials_Test"/>
            <class name="ecommerce.SwagLabs.Cart.OpencartSection_Test"/>
            <class name="ecommerce.SwagLabs.Login.UserLoginLogout_Test"/>
        </classes>
    </test>

    <!-- Firefox -->
    <test name="Firefox Tests">
        <parameter name="browser" value="firefox"/>

        <classes>
            <class name="ecommerce.SwagLabs.Login.UserLoginWithInvalidUsername_Test"/>
            <class name="ecommerce.SwagLabs.Cart.ProductAddedToCart_Test"/>
            <class name="ecommerce.SwagLabs.Login.UserLoginWithValidCredentials_Test"/>
            <class name="ecommerce.SwagLabs.Cart.OpencartSection_Test"/>
            <class name="ecommerce.SwagLabs.Login.UserLoginLogout_Test"/>
        </classes>
    </test>

    <!-- Edge -->
    <test name="Edge Tests">
        <parameter name="browser" value="edge"/>

        <classes>
            <class name="ecommerce.SwagLabs.Login.UserLoginWithInvalidUsername_Test"/>
            <class name="ecommerce.SwagLabs.Cart.ProductAddedToCart_Test"/>
            <class name="ecommerce.SwagLabs.Login.UserLoginWithValidCredentials_Test"/>
            <class name="ecommerce.SwagLabs.Cart.OpencartSection_Test"/>
            <class name="ecommerce.SwagLabs.Login.UserLoginLogout_Test"/>
        </classes>
    </test>

</suite>
